<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose">
    <GuiProfiles>
        <Profile name="tmsUrlTitle" extends="baseReference" with="anchorTopLeft">
            <position value="44px -30px"/>
            <size value="912px 36px"/>
            <textSize value="24px"/>
            <textBold value="true"/>
        </Profile>
        <Profile name="tmsUrlPrompt" extends="baseReference" with="anchorTopLeft">
            <position value="44px -76px"/>
            <size value="912px 48px"/>
            <textSize value="18px"/>
            <textLayoutMode value="resize"/>
            <textMaxNumLines value="2"/>
        </Profile>
        <Profile name="tmsUrlInput" extends="fs25_dialogTextInput" with="anchorTopLeft">
            <position value="44px -142px"/>
            <size value="912px 48px"/>
            <textSize value="18px"/>
            <maxInputTextWidth value="844px"/>
            <maxCharacters value="2048"/>
            <applyProfanityFilter value="false"/>
        </Profile>
        <Profile name="tmsPixelTestButton" extends="baseReference" with="anchorTopLeft">
            <position value="44px -214px"/>
            <size value="912px 40px"/>
            <textSize value="18px"/>
            <textAlignment value="center"/>
            <textColor value="0.9 0.9 0.9 1"/>
            <imageColor value="0.15 0.15 0.15 1"/>
            <imageFocusedColor value="0.3 0.3 0.3 1"/>
            <imageHighlightedColor value="0.3 0.3 0.3 1"/>
            <handleFocus value="true"/>
        </Profile>
    </GuiProfiles>
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg"/>
    <GuiElement profile="fs25_dialogBg" size="1000px 360px">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>
        <Text profile="tmsUrlTitle" id="titleElement"/>
        <Text profile="tmsUrlPrompt" id="promptElement"/>
        <TextInput profile="tmsUrlInput" id="textInputElement"
            onEnterPressed="onEnterPressed" onEscPressed="onEscPressed"
            onIsUnicodeAllowed="onIsUnicodeAllowed" enterWhenClickOutside="false"
            focusInit="onOpen" maxCharacters="2048" applyProfanityFilter="false">
            <ThreePartBitmap profile="fs25_textInputBg"/>
            <Bitmap profile="fs25_textInputIconBox">
                <Bitmap profile="fs25_textInputIcon"/>
            </Bitmap>
        </TextInput>
        <Button profile="tmsPixelTestButton" id="pixelTestButton" onClick="onClickPixelTest" visible="false"/>
        <BoxLayout profile="fs25_dialogButtonBox">
            <Button profile="buttonOK" id="confirmButton" onClick="onClickOk"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonActivate" id="videoTestButton" onClick="onClickVideoTest"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack"/>
        </BoxLayout>
    </GuiElement>
</GUI>
